        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Random product">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.nio.file.*
import java.util.concurrent.ThreadLocalRandom

// ===== CONFIG =====
def CSV_DIR  = &quot;/Users/thanhthuy/Downloads/csv&quot;   // &lt;-- chỉnh path
def CAT_CSV  = Paths.get(CSV_DIR, &quot;categories.csv&quot;)
def PROD_CSV = Paths.get(CSV_DIR, &quot;products.csv&quot;)

// slug của category đã chọn ở bước trước (từ CSV khác/JSR223 khác)
def slug = vars.get(&quot;cat_slug&quot;)

// ===== BUILD CACHE ONCE (for all threads) =====
if (props.get(&quot;toolshop.maps.built&quot;) != &quot;1&quot;) {
    // slug -&gt; category_id
    Map slugToCatId = new LinkedHashMap()
    Files.readAllLines(CAT_CSV).drop(1).each { line -&gt;
        if (!line?.trim()) return
        def parts = line.split(&quot;,&quot;, 3)        // id,name,slug
        if (parts.length &gt;= 3) {
            slugToCatId.put(parts[2].trim(), parts[0].trim())
        }
    }

    // category_id -&gt; [product_id, ...]
    Map catIdToProdIds = new LinkedHashMap()
    Files.readAllLines(PROD_CSV).drop(1).each { line -&gt;
        if (!line?.trim()) return
        def parts = line.split(&quot;,&quot;, 3)        // id,name,category_id
        if (parts.length &gt;= 3) {
            def prodId = parts[0].trim()
            def catId  = parts[2].trim()
            catIdToProdIds.computeIfAbsent(catId, { new ArrayList&lt;String&gt;() }).add(prodId)
        }
    }

    // Lưu vào props (OK với Object)
    props.put(&quot;toolshop.slugToCatId&quot;, slugToCatId)
    props.put(&quot;toolshop.catIdToProdIds&quot;, catIdToProdIds)
    props.put(&quot;toolshop.maps.built&quot;, &quot;1&quot;)
    log.info(&quot;Built maps: slugs=${slugToCatId.size()}, buckets=${catIdToProdIds.size()}&quot;)
}

// ===== PICK ONE PRODUCT IN THE CHOSEN CATEGORY =====
Map slugToCatId   = (Map) props.get(&quot;toolshop.slugToCatId&quot;)
Map catIdToProdIds= (Map) props.get(&quot;toolshop.catIdToProdIds&quot;)

def catId = slugToCatId?.get(slug)
if (!catId) {
    log.warn(&quot;No catId for slug=${slug}, fallback catId=3&quot;)
    catId = &quot;3&quot;
}
def options = (List) catIdToProdIds?.get(catId)
if (!options || options.isEmpty()) {
    log.warn(&quot;No products for catId=${catId} (slug=${slug}), fallback prodId=1&quot;)
    vars.put(&quot;pickedProductId&quot;, &quot;1&quot;)
} else {
    int idx = ThreadLocalRandom.current().nextInt(options.size())
    vars.put(&quot;pickedProductId&quot;, options.get(idx))
}
log.info(&quot;Picked slug=${slug}, catId=${catId}, productId=${vars.get(&apos;pickedProductId&apos;)}&quot;)</stringProp>
        </JSR223Sampler>
