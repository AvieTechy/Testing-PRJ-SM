        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Random category" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.nio.file.*
import java.util.concurrent.ThreadLocalRandom

// Đường dẫn tuyệt đối tới file categories.csv
// Lưu ý: phải đúng với máy bạn
def path = Paths.get(&quot;/Users/thanhthuy/Downloads/csv/categories.csv&quot;)

// Đọc toàn bộ dòng, bỏ header
def lines = Files.readAllLines(path)
lines.remove(0) // bỏ dòng tiêu đề

// Random 1 dòng bất kỳ
def pickLine = lines.get(ThreadLocalRandom.current().nextInt(lines.size()))

// Tách theo dấu phẩy
def parts = pickLine.split(&quot;,&quot;)

// Cột slug là cột thứ 3 (index 2)
def slug = parts[2].trim()

// Lưu vào biến JMeter
vars.put(&quot;cat_slug&quot;, slug)

log.info(&quot;Picked category slug = &quot; + slug)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
