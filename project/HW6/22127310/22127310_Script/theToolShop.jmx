def CAT_CSV  = Paths.get(CSV_DIR, &quot;categories.csv&quot;)
def PROD_CSV = Paths.get(CSV_DIR, &quot;products.csv&quot;)

// slug của category đã chọn ở bước trước (từ CSV khác/JSR223 khác)
