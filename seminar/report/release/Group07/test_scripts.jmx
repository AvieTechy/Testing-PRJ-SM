          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Randomize Category/Product/Item" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.Random
import java.nio.file.Files
import java.nio.file.Paths

// 1. Danh sách các category có thể chọn
def categories = [&apos;FISH&apos;, &apos;DOGS&apos;, &apos;CATS&apos;, &apos;BIRDS&apos;, &apos;REPTILES&apos;]

// 2. Random 1 category
def selectedCategory = categories[new Random().nextInt(categories.size())]
vars.put(&quot;selectedCategory&quot;, selectedCategory)

// 3. Đọc file CSV &amp; lọc dòng có category trùng
def csvFilePath = &quot;D:/demo-testing/product_summary.csv&quot;
def lines = Files.readAllLines(Paths.get(csvFilePath))
def headerRemoved = lines.drop(1) // Loại bỏ header nếu có
def matched = headerRemoved.findAll { it.split(&apos;,&apos;)[0] == selectedCategory }

// 4. Random 1 dòng từ matched
if (matched.isEmpty()) {
    log.error(&quot;Không tìm thấy dữ liệu cho category: ${selectedCategory}&quot;)
    return
}
def chosen = matched[new Random().nextInt(matched.size())]
def parts = chosen.split(&apos;,&apos;)

// 5. Gán lại vào biến JMeter
vars.put(&quot;categoryId&quot;, parts[0])
vars.put(&quot;productId&quot;, parts[1])
vars.put(&quot;itemId&quot;, parts[2])

// Ghi log để kiểm tra
log.info(&quot;Đã chọn: categoryId=${parts[0]}, productId=${parts[1]}, itemId=${parts[2]}&quot;)</stringProp>
